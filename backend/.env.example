SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lexcvservice_db
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=dGhpcy1pcy1ub3QtYS1yZWFsLXNlY3JldC1jaGFuZ2UtbWU=
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
# Optional: public-facing URL for presigned download links (defaults to MINIO_ENDPOINT).
# Set this when the backend reaches MinIO via an internal hostname (e.g. Docker service
# name) that is not reachable from a browser. Example: MINIO_PUBLIC_ENDPOINT=https://storage.example.com
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lexcv-documentos
# eFatura (Phase 136): modo do adaptador; só SIMULADO existe neste build -- qualquer outro valor
# (REAL, minúsculas, vazio) impede o arranque. Opcional: por omissão SIMULADO.
EFATURA_MODE=SIMULADO
# Opcionais: bloco Transmission do DFE. Valores sintéticos de teste, válidos só em SIMULADO
# (por omissão os mesmos de application.yml; substituir no milestone de ligação real).
# EFATURA_TRANSMISSOR_NIF=999999999
# EFATURA_SOFTWARE_CODIGO=LEXCVSIM
# EFATURA_SOFTWARE_NOME=LexCV
# EFATURA_SOFTWARE_VERSAO=3.0.0
# Email fiscal (Phase 137, ENTR-03/ENTR-06) — TODOS opcionais.
# SMTP_HOST vazio (ou ausente) = envio "Não configurado": a aplicação arranca e emite normalmente,
# os documentos ficam com o envio por email marcado como não configurado.
# Com SMTP_HOST definido, SMTP_FROM é obrigatório (endereço válido) ou o arranque falha.
# Credenciais SMTP só aqui (variáveis de ambiente) -- nunca no código nem na base de dados.
# Antes de ligar um servidor SMTP real é obrigatório o checkpoint humano da fase 137.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=faturacao@exemplo.cv
# SMTP_STARTTLS=true
# Exemplo local (capturador Mailpit, sem envio real):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=faturacao@exemplo.cv
# SMTP_STARTTLS=false
