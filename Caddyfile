:80 {
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /pgadmin* {
        reverse_proxy pgadmin:80 {
            header_up X-Script-Name /pgadmin
        }
    }

    @webpage {
        path / /landing-static/*
    }
    handle @webpage {
        reverse_proxy webpage:3000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
