# PostgreSQL
POSTGRES_DB=lexcvservice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-base64-encoded-secret
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# CORS (comma-separated; for local dev Caddy handles same-origin so set to Caddy host)
# production: use https://your-actual-domain.com
CORS_ALLOWED_ORIGINS=http://localhost

# Seeding (set true only for first run)
SEED_ENABLED=false

# Domain (required in production for Caddy HTTPS)
# production: DOMAIN_NAME=alcv.tech
DOMAIN_NAME=yourdomain.com

# Caddy MinIO console basic auth
# Generate hash with: caddy hash-password --plaintext yourpassword
CADDY_MINIO_USER=admin
CADDY_MINIO_PASSWORD_HASH=change-me-caddy-hashed-password

# Registry and image tag (CI sets these)
REGISTRY=ghcr.io/tchspprtcv/lexcv
IMAGE_TAG=latest

# MinIO (for local docker desktop deployment)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lexcv-documentos
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

