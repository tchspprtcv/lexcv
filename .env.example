# PostgreSQL
POSTGRES_DB=lexcvservice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-base64-encoded-secret
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# CORS (comma-separated; for local dev Caddy handles same-origin so set to Caddy host)
CORS_ALLOWED_ORIGINS=http://localhost

# Seeding (set true only for first run)
SEED_ENABLED=false
