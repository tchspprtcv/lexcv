# PostgreSQL
POSTGRES_DB=lexcvservice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@lexcv.cv
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# JWT
JWT_SECRET=change-me-base64-encoded-secret
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# CORS (comma-separated; supports exact origins and wildcard patterns e.g. http://localhost:*, http://lexcv:*)
# production: use https://your-actual-domain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3003,http://lexcv:3003,http://localhost:*,http://lexcv:*

# Two-stage boot (see DEPLOYMENT.md, "Database Schema - Two-Stage Boot").
# Stage 1, first boot ever:  SPRING_JPA_HIBERNATE_DDL_AUTO=update   SEED_ENABLED=true
# Stage 2, from then on:     SPRING_JPA_HIBERNATE_DDL_AUTO=validate SEED_ENABLED=false
# Both keys are read from here by docker-compose.yml AND by docker-compose.hostinger.yml.
# If you set neither, both files default to the stage-1 values (update / true).
# NOTE: the values below are NOT stage 1 - on a brand-new database you must also set
# SEED_ENABLED=true for the first boot, or no admin user is created.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SEED_ENABLED=false

# Domain (required in production for Caddy HTTPS)
# production: DOMAIN_NAME=alcv.tech
DOMAIN_NAME=yourdomain.com

# Caddy MinIO console basic auth
# Generate hash with: caddy hash-password --plaintext yourpassword
CADDY_MINIO_USER=admin
CADDY_MINIO_PASSWORD_HASH=change-me-caddy-hashed-password

# Registry and image tag (CI sets these)
REGISTRY=ghcr.io/tchspprtcv/lexcv
IMAGE_TAG=latest

# MinIO (for local docker desktop deployment)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=lexcv-documentos
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# eFatura (Phase 136, DFE-02 / Phase 139, OPER-03)
# Modo de comunicação com a DNRE. No v3.0 apenas "SIMULADO" é suportado. Qualquer outro valor aborta o arranque.
EFATURA_MODE=SIMULADO
EFATURA_TRANSMISSOR_NIF=999999999
EFATURA_SOFTWARE_CODIGO=LEXCVSIM
EFATURA_SOFTWARE_NOME=LexCV
EFATURA_SOFTWARE_VERSAO=3.0.0

# Email fiscal (Phase 137, ENTR-03/ENTR-06 / Phase 139, OPER-03) — TODOS opcionais.
# SMTP_HOST vazio (ou ausente) = envio "Não configurado": a aplicação arranca e emite normalmente,
# os documentos ficam com o envio por email marcado como não configurado.
# Com SMTP_HOST definido, SMTP_FROM é obrigatório (endereço válido) ou o arranque falha.
# Credenciais SMTP só aqui (variáveis de ambiente) -- nunca no código nem na base de dados.
# Antes de ligar um servidor SMTP real é obrigatório o checkpoint humano da fase 137.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=faturacao@exemplo.cv
# SMTP_STARTTLS=true
# Exemplo local (capturador Mailpit, sem envio real):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=faturacao@exemplo.cv
# SMTP_STARTTLS=false
